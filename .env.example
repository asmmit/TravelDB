# TravelDB Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.

# --- Database Configuration (MySQL 8.0) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=traveldb
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here

# --- External API Keys ---
# TomTom Developer Portal (https://developer.tomtom.com) - 2,500 free calls/day
TOMTOM_API_KEY=your_tomtom_api_key_here

# HERE Developer Portal (https://developer.here.com) - Optional alternate feed
HERE_API_KEY=your_here_api_key_here

# Open-Meteo Weather API requires NO API key for standard non-commercial use.
# Nominatim Geocoding requires a custom User-Agent identifying your application and email:
NOMINATIM_USER_AGENT=TravelDB_Student_Project/1.0 (contact: student@traveldb.local)

# --- Application Settings ---
FLASK_ENV=development
FLASK_SECRET_KEY=change_this_to_a_random_secure_hex_key_for_sessions
PORT=5000
